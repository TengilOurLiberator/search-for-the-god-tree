{
  "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "stable-audio-open-1.0.safetensors" } },
  "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "t5_base.safetensors", "type": "stable_audio", "device": "default" } },
  "3": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["2", 0], "text": "%PROMPT%" } },
  "4": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["2", 0], "text": "music, melody, speech, voice, low quality, hiss, noise, distortion" } },
  "5": { "class_type": "ConditioningStableAudio", "inputs": { "positive": ["3", 0], "negative": ["4", 0], "seconds_start": 0.0, "seconds_total": "%SECONDS%" } },
  "6": { "class_type": "EmptyLatentAudio", "inputs": { "seconds": "%SECONDS%", "batch_size": 1 } },
  "7": { "class_type": "KSampler", "inputs": { "model": ["1", 0], "positive": ["5", 0], "negative": ["5", 1], "latent_image": ["6", 0], "seed": "%SEED%", "steps": 60, "cfg": 6.0, "sampler_name": "dpmpp_3m_sde_gpu", "scheduler": "exponential", "denoise": 1.0 } },
  "8": { "class_type": "VAEDecodeAudio", "inputs": { "samples": ["7", 0], "vae": ["1", 2] } },
  "10": { "class_type": "AudioAdjustVolume", "inputs": { "audio": ["8", 0], "volume": -9 } },
  "9": { "class_type": "SaveAudio", "inputs": { "audio": ["10", 0], "filename_prefix": "%ID%" } }
}
