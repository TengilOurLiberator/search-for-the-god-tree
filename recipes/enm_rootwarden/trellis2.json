  "30": { "class_type": "ApplyTextureToMesh", "inputs": { "mesh": ["28", 0], "base_color": ["29", 0], "metallic": ["29", 1], "roughness": ["29", 2] } },
  "31": { "class_type": "SaveGLB", "inputs": { "mesh": ["30", 0], "filename_prefix": "%ID%" } }
