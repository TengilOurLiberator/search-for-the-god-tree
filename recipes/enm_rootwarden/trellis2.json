  "14": { "class_type": "KSampler", "inputs": { "model": ["12", 0], "positive": ["6", 0], "negative": ["6", 1], "latent_image": ["13", 0], "seed": "%SEED%", "steps": 12, "cfg": 7.5, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0 } },
  "15": { "class_type": "VaeDecodeStructureTrellis2", "inputs": { "samples": ["14", 0], "vae": ["8", 0], "resolution": "32" } },
  "16": { "class_type": "CFGOverride", "inputs": { "model": ["7", 0], "cfg": 1.0, "start_percent": 0.769, "end_percent": 1.0 } },
  "17": { "class_type": "RescaleCFG", "inputs": { "model": ["16", 0], "multiplier": 0.5 } },
  "18": { "class_type": "Trellis2ShapeStage", "inputs": { "positive": ["6", 0], "negative": ["6", 1], "voxel": ["15", 0] } },
  "19": { "class_type": "KSampler", "inputs": { "model": ["17", 0], "positive": ["18", 0], "negative": ["18", 1], "latent_image": ["18", 2], "seed": "%SEED%", "steps": 20, "cfg": 7.5, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0 } },
  "20": { "class_type": "Trellis2UpsampleStage", "inputs": { "positive": ["18", 0], "negative": ["18", 1], "shape_latent": ["19", 0], "vae": ["8", 0], "target_resolution": 1536 } },
  "21": { "class_type": "KSampler", "inputs": { "model": ["17", 0], "positive": ["20", 0], "negative": ["20", 1], "latent_image": ["20", 2], "seed": "%SEED%", "steps": 12, "cfg": 7.5, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0 } },
  "22": { "class_type": "VaeDecodeShapeTrellis", "inputs": { "samples": ["21", 0], "vae": ["8", 0] } },
  "23": { "class_type": "Trellis2TextureStage", "inputs": { "positive": ["20", 0], "negative": ["20", 1], "shape_latent": ["21", 0] } },
  "24": { "class_type": "KSampler", "inputs": { "model": ["7", 0], "positive": ["23", 0], "negative": ["23", 1], "latent_image": ["23", 2], "seed": "%SEED%", "steps": 12, "cfg": 1.0, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0 } },
  "25": { "class_type": "VaeDecodeTextureTrellis", "inputs": { "samples": ["24", 0], "vae": ["9", 0], "shape_subdivides": ["22", 1] } },
  "32": { "class_type": "RemeshMesh", "inputs": { "mesh": ["22", 0], "resolution": 384, "sign_mode": "udf", "sign_mode.qef": false, "sign_mode.drop_inverted_components": false, "sign_mode.drop_enclosed_components": false, "band": 1.0, "project_back": 0.0, "fix_poles": false, "smooth_iters": 20, "drop_small_components": 0.01, "precluster_max_verts": 20000000 } },
  "26": { "class_type": "DecimateMesh", "inputs": { "mesh": ["32", 0], "target_face_count": "%TRIS%", "placement_mode": "qem", "placement_mode.line_quadric_weight": 0.0, "placement_mode.feature_edge_quadric_weight": 0.0, "placement_mode.feature_edge_min_dihedral_deg": 30.0, "placement_mode.clamp_v_to_edge": true } },
