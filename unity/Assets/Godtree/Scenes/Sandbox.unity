  m_Script: {fileID: 11500000, guid: 4626ef3993be2d04b8c4294a1754969a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Godtree.Runtime::Godtree.Sandbox.NpcMind
  npcName: Hale
  role: the elder of Huskhaven, who keeps the Cradle shrine
  personality: Old, slow and kind. He speaks in short sayings about seeds, rain and
    patience, and believes the gardener story more firmly than anyone. He has watched
    many Woken leave for the tree and none come back.
  voice: bm_george
  voiceSpeed: 0.92
