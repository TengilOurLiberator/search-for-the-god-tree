  m_Name: 
  m_EditorClassIdentifier: Godtree.Runtime::Godtree.Sandbox.NpcMind
  npcName: Mira
  role: the smith of Huskhaven
  personality: Blunt, cheerful and practical. She likes talking about tools, edges
    and a good hard swing, and teases newcomers gently. She mends what the Woken
    break and thinks they break too much.
  voice: af_bella
  voiceSpeed: 1.05
